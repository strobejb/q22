// q22-strata-v1
//
//  woff.strata
//

include "basetypes.strata";
include "sfnt.strata";

enum WOFF_SFNT_FLAVOR
{
    WOFF_SFNT_TRUETYPE_1_0 = 0x00010000,
    WOFF_SFNT_TRUETYPE     = 0x74727565,
    WOFF_SFNT_OPENTYPE_CFF = 0x4f54544f
};

[
    dynamic_struct(name("Decoded head"),
                   type(SFNT_HEAD_TABLE),
                   offset(offset),
                   optional(tag == fourcc("head") && compLength == origLength && origLength >= sizeof(SFNT_HEAD_TABLE))),
    dynamic_struct(name("Decoded hhea"),
                   type(SFNT_HHEA_TABLE),
                   offset(offset),
                   optional(tag == fourcc("hhea") && compLength == origLength && origLength >= sizeof(SFNT_HHEA_TABLE))),
    dynamic_struct(name("Decoded maxp"),
                   type(SFNT_MAXP_TABLE),
                   offset(offset),
                   optional(tag == fourcc("maxp") && compLength == origLength && origLength >= 6)),
    dynamic_struct(name("Decoded name"),
                   type(SFNT_NAME_TABLE),
                   offset(offset),
                   optional(tag == fourcc("name") && compLength == origLength && origLength >= 6)),
    dynamic_struct(name("Decoded cmap"),
                   type(SFNT_CMAP_TABLE),
                   offset(offset),
                   optional(tag == fourcc("cmap") && compLength == origLength && origLength >= 4)),
    dynamic_array(name(TableData),
                  type(BYTE),
                  offset(offset),
                  count(compLength),
                  nested(type(auto),
                         offset(offset),
                         extent(compLength),
                         optional(compLength != 0 && compLength == origLength),
                         name(tag)),
                  optional(compLength != 0 && compLength == origLength)),
    dynamic_array(name(CompressedData),
                  type(BYTE),
                  offset(offset),
                  count(compLength),
                  nested(type(auto),
                         offset(offset),
                         extent(compLength),
                         transform("zlib"),
                         optional(compLength != 0 && compLength < origLength),
                         name(tag)),
                  optional(compLength != 0 && compLength < origLength))
]
typedef struct _WOFF_TABLE_DIRECTORY_ENTRY
{
    [format("fourcc")]
    dword tag;

    dword offset;
    dword compLength;
    dword origLength;
    dword origChecksum;
} WOFF_TABLE_DIRECTORY_ENTRY, *PWOFF_TABLE_DIRECTORY_ENTRY;

typedef struct _WOFF_HEADER
{
    [string, count(4)]
    char signature[];

    [enum(WOFF_SFNT_FLAVOR)]
    dword flavor;

    dword length;
    word numTables;
    word reserved;
    dword totalSfntSize;
    word majorVersion;
    word minorVersion;

    [dynamic_array(name(Metadata),
                   type(BYTE),
                   offset(metaOffset),
                   count(metaLength),
                   nested(type(auto),
                          offset(metaOffset),
                          extent(metaLength),
                          transform("zlib"),
                          optional(metaOffset != 0 && metaLength != 0),
                          name("Metadata")),
                   optional(metaOffset != 0 && metaLength != 0))]
    dword metaOffset;

    dword metaLength;
    dword metaOrigLength;

    [dynamic_array(name(PrivateData),
                   type(BYTE),
                   offset(privOffset),
                   count(privLength),
                   nested(type(auto),
                          offset(privOffset),
                          extent(privLength),
                          optional(privOffset != 0 && privLength != 0),
                          name("PrivateData")),
                   optional(privOffset != 0 && privLength != 0))]
    dword privOffset;

    dword privLength;
} WOFF_HEADER, *PWOFF_HEADER;

[
    export("Web Open Font Format (WOFF)"),
    version(1),
    category("font"),
    assoc(".woff"),
    magic({ 'w', 'O', 'F', 'F' }),
    offset(0),
    endian("big")
]
typedef struct _WOFF
{
    WOFF_HEADER header;

    [count(header.numTables), element(name(tag))]
    WOFF_TABLE_DIRECTORY_ENTRY tables[];
} WOFF;
